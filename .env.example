# ============================================================
# HireSmart AI — Environment Variables
# Copy this file to .env and fill in values before running
# NEVER commit .env to version control
# ============================================================

# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=HireSmart AI
DEBUG=true
SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=hiresmart
POSTGRES_PASSWORD=hiresmart_secret
POSTGRES_DB=hiresmart_db
# LOCAL (Docker Compose):
DATABASE_URL=postgresql+asyncpg://hiresmart:hiresmart_secret@postgres:5432/hiresmart_db
# PRODUCTION (Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/hiresmart?ssl=require

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secret@redis:6379/1

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@hiresmart.ai
EMAIL_FROM_NAME=HireSmart AI

# ── File Storage (Local Dev) ─────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx

# ── Ollama / LLM ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120

# ── HuggingFace ──────────────────────────────────────────────
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_CACHE_DIR=/app/.cache/huggingface

# ── FAISS ────────────────────────────────────────────────────
FAISS_INDEX_PATH=/app/data/faiss_index

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HireSmart AI
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret-32-chars-min

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Security ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
BCRYPT_ROUNDS=12
